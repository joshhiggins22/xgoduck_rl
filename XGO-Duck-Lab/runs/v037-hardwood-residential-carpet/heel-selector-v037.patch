diff --git a/assets/heel-control.js b/assets/heel-control.js
new file mode 100644
index 0000000..7aa81ec
--- /dev/null
+++ b/assets/heel-control.js
@@ -0,0 +1,74 @@
+(() => {
+  const group = document.getElementById('heel-profiles');
+  const inputs = Array.from(group.querySelectorAll('input[name="heel-profile"]'));
+  const message = document.getElementById('heel-error');
+  let selected = null, available = {}, desired = null, busy = false;
+  let revision = 0, nextPoll = 0, lastPoll = 0;
+
+  function render() {
+    group.setAttribute('aria-busy', String(busy));
+    for (const input of inputs) {
+      input.checked = input.value === (desired || selected);
+      input.disabled = available[input.value] !== true;
+    }
+  }
+
+  function accept(profile) {
+    if (!profile || !inputs.some(input => input.value === profile.selected) || !profile.available) {
+      throw Error('Heel profile status unavailable');
+    }
+    selected = profile.selected;
+    available = profile.available;
+  }
+
+  function beginPoll() {
+    return {revision, id: ++nextPoll};
+  }
+
+  function update(status, poll) {
+    if (busy || poll.revision !== revision || poll.id <= lastPoll) return;
+    lastPoll = poll.id;
+    try { accept(status?.heel_profile); }
+    catch { available = {}; }
+    render();
+  }
+
+  async function save() {
+    if (busy) return;
+    busy = true;
+    render();
+    try {
+      // Serialize changes even if a second radio is chosen before the first POST returns.
+      while (desired !== null && desired !== selected) {
+        const requested = desired;
+        const response = await fetch('/api/heel-profile', {
+          method: 'POST', headers: {'Content-Type': 'application/json'},
+          body: JSON.stringify({profile: requested}), signal: AbortSignal.timeout(5000)
+        });
+        const data = await response.json();
+        if (!response.ok) throw Error(data.detail || response.statusText);
+        accept(data);
+        if (data.selected !== requested) throw Error('Heel profile change was not confirmed');
+      }
+    } catch (error) {
+      available = {};
+      message.textContent = error.message;
+    } finally {
+      desired = null;
+      busy = false;
+      revision++;
+      render();
+    }
+  }
+
+  group.addEventListener('change', event => {
+    const input = event.target;
+    if (!inputs.includes(input) || input.disabled || !input.checked) return;
+    desired = input.value;
+    revision++;
+    message.textContent = '';
+    render();
+    void save();
+  });
+  window.DuckHeels = {beginPoll, update};
+})();
